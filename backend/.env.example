PORT=5000

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=afronexia_db
# Alternativa en la nube: DATABASE_URL=postgres://usuario:clave@host:5432/afronexia_db
# DB_SSL=true

# --- Seguridad ---
# Cadena larga y aleatoria. Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES=8h
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000
# true solo para crear el primer administrador desde la web
ALLOW_ADMIN_SIGNUP=false

# --- Agente NEXIA ---
# openai | anthropic | local  (vacío = el primero que tenga clave; sin claves = local)
IA_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
